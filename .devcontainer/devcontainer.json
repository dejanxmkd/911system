{
  "name": "AI Background Removal",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Background Removal API",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "python -m pip install -r requirements-api.txt",
  "postStartCommand": "bash scripts/start_codespace.sh",
  "remoteEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/src"
  }
}
